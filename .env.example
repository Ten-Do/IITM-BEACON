# Copy this file to `.env` (gitignored) and fill in real values for local
# `docker compose up`/`docker compose run` usage. Never commit real secrets.

# --- Postgres (db + app services) ---
DB_NAME=beacon
DB_USERNAME=beacon
DB_PASSWORD=change-me

# --- App crypto (see docs/decisions.md #6) ---
# Must base64-decode to exactly 32 bytes (AES-256). Generate e.g. via:
#   openssl rand -base64 32
BEACON_ENCRYPTION_KEY=change-me-32-bytes-base64
# Arbitrary secret string used to pepper the email lookup HMAC.
BEACON_EMAIL_HASH_PEPPER=change-me

# --- Admin auth (see docs/decisions.md #4) ---
ADMIN_EMAIL=admin@example.com

# --- Login sessions (admin and visitor) ---
# How long an idle login lasts, as a duration (e.g. 24h, 90m). Defaults to 24h.
BEACON_SESSION_TIMEOUT=24h
# Mark the session cookie (JSESSIONID) and the CSRF cookie (XSRF-TOKEN) Secure even though
# the app itself sees plain http behind a TLS-terminating reverse proxy. Defaults to true in
# the prod profile (docker compose), false in dev. Set false only when browsers reach the
# site over plain http from another machine (e.g. http://<LAN address>:8081): browsers drop
# Secure cookies there, so nobody could log in or submit a form. http://localhost works either way.
# BEACON_COOKIE_SECURE=true

# --- Public address (same-origin check of the article's contact reveal) ---
# The origin(s) browsers use to reach the site, scheme://host[:port], comma-separated.
# Leave empty when browsers reach the app directly (each request's own origin is used).
# Behind a reverse proxy (TLS termination, another host name or port) set it, e.g.
#   BEACON_ALLOWED_ORIGINS=https://beacon.example
BEACON_ALLOWED_ORIGINS=

# --- Reverse proxy: the visitor's address (per-IP OTP limits) and https ---
# The IP address(es) of the reverse proxy in front of the app, comma-separated, exactly as
# the app sees it connect (e.g. the proxy container's fixed address on the Docker network).
# From those addresses only, X-Forwarded-For gives the visitor's address and X-Forwarded-Proto
# the scheme; from anywhere else both are ignored. Never a range or host name (the app refuses
# to start). Leave empty without a proxy. Behind a proxy that is left empty, every visitor
# shares the proxy's address, so one visitor's OTP requests can rate-limit everyone. The proxy
# must append the client's address to X-Forwarded-For (nginx: proxy_set_header
# X-Forwarded-For $proxy_add_x_forwarded_for) and set X-Forwarded-Proto (nginx: $scheme).
BEACON_TRUSTED_PROXIES=

# --- Rejected-testimonial retention (see docs/decisions.md #3) ---
# When the job runs that deletes testimonials rejected more than 30 days ago: a Spring
# cron expression (second minute hour day-of-month month day-of-week), evaluated in UTC.
# Defaults to Sundays at 03:00 UTC; set it to - to switch the job off.
# BEACON_RETENTION_CRON="0 0 3 * * SUN"

# --- SMTP (OTP delivery in prod; dev/test log the OTP instead of sending it — see
#     docs/architecture.md §13) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me

# --- Photo storage (see docs/decisions.md #2, docs/architecture.md §7) ---
# Directory photos are written to/served from; docker-compose.yml already mounts a volume here.
BEACON_UPLOADS_ROOT=/data/uploads
# Max photos per testimonial and per topic (saved photos plus new uploads), and max
# size (bytes) of each single photo file (20 MB). Raising the count or the size also
# needs a larger multipart request limit, BEACON_UPLOAD_MAX_REQUEST_SIZE (default
# 1010MB = 50 photos x 20 MB + form text).
BEACON_PHOTO_MAX_COUNT=50
BEACON_PHOTO_MAX_PER_SECTION=5
BEACON_PHOTO_MAX_SIZE_BYTES=20971520
# Largest multipart request accepted anywhere but the three submission endpoints (which alone
# take photos, within the limits above): bigger ones, or ones of unknown length, are refused
# before they are read. Defaults to 16KB.
# BEACON_NON_UPLOAD_MULTIPART_MAX_SIZE=16KB
# Every upload is stored as a lossy WebP plus a thumbnail. Largest accepted image
# in pixels (checked before decoding); long edge (px) of the full-size image and
# of the thumbnail, at most 16383; WebP quality 0-100 of each.
BEACON_PHOTO_MAX_PIXELS=250000000
BEACON_PHOTO_FULL_MAX_EDGE=2560
BEACON_PHOTO_THUMB_MAX_EDGE=640
BEACON_PHOTO_WEBP_QUALITY=82
BEACON_PHOTO_WEBP_THUMB_QUALITY=75
# Convert photos stored before the WebP pipeline once, at startup (true/false).
BEACON_PHOTO_BACKFILL_ENABLED=true
