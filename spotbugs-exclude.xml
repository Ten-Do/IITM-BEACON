<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
  <!-- Lombok-generated getters/setters/builders on JPA entities intentionally
       expose/accept internal mutable state (collections, Instant, etc.) —
       that is simply how JPA entity accessors work. Scoped to domain.. only,
       so hand-written business logic elsewhere is still fully checked. -->
  <Match>
    <Package name="~com\.iitm\.beacon\.domain\..*"/>
    <Or>
      <Bug pattern="EI_EXPOSE_REP"/>
      <Bug pattern="EI_EXPOSE_REP2"/>
    </Or>
  </Match>

  <!-- ObjectMapper is a shared, effectively-immutable-in-practice Spring
       bean (its configuration is fixed once at application startup),
       constructor-injected exactly as any other collaborator — not
       attacker-controlled mutable state. Defensively copying it per
       instance would add real cost (Jackson module/config re-resolution)
       for no actual safety benefit. Scoped to the two classes that hold it
       this way, not a package-wide exclusion. -->
  <Match>
    <Or>
      <Class name="com.iitm.beacon.common.error.RestAccessDeniedHandler"/>
      <Class name="com.iitm.beacon.common.error.RestAuthenticationEntryPoint"/>
    </Or>
    <Field name="objectMapper"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>

  <!-- Same false positive, same reasoning, on M3's submission-slice
       collaborators: each is a constructor-injected, stateless-in-practice
       Spring service bean, not attacker-controlled mutable state. Scoped to
       the exact (class, field) pairs SpotBugs flagged, not a package-wide
       exclusion. -->
  <Match>
    <Class name="com.iitm.beacon.submission.SubmissionController"/>
    <Field name="submissionService"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.iitm.beacon.submission.SubmissionService"/>
    <Field name="photoStorageService"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
  <Match>
    <Class name="com.iitm.beacon.submission.VisitorAuthController"/>
    <Field name="submissionService"/>
    <Bug pattern="EI_EXPOSE_REP2"/>
  </Match>
</FindBugsFilter>
